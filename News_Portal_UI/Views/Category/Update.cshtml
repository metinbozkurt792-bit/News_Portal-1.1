@{
    ViewData["Title"] = "Kategori Güncelle";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-warning text-dark p-4 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Kategori Güncelleme</h4>
            </div>
            <div class="card-body p-4 text-center">
                <div id="loader" class="py-5">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-2 text-muted">Kategori verileri getiriliyor...</p>
                </div>

                <form id="updateCategoryForm" class="d-none">
                    <input type="hidden" id="hdnCategoryId" value="@ViewBag.CategoryId" />

                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold text-secondary small text-uppercase">KATEGORİ ADI</label>
                        <input type="text" id="txtName" class="form-control form-control-lg fs-6" placeholder="Kategori adını girin...">
                    </div>

                    <div class="mb-4 text-start">
                        <label class="form-label fw-bold text-secondary small text-uppercase">AÇIKLAMA</label>
                        <textarea id="txtDescription" class="form-control" rows="4" placeholder="Kategori açıklamasını güncelleyin..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <a href="/Category/Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Vazgeç
                        </a>
                        <button type="button" class="btn btn-warning fw-bold rounded-pill px-5 shadow-sm text-dark" onclick="updateCategory()">
                            <i class="bi bi-check-lg me-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7043/api/Category";
        const adminToken = localStorage.getItem("myToken");
        const categoryId = $("#hdnCategoryId").val();

        $(document).ready(function () {
            if (!adminToken) {
                window.location.href = "/Auth/Login";
                return;
            }

            if (categoryId) {
                $.ajax({
                    url: API_URL + "/" + categoryId,
                    type: "GET",
                    headers: { "Authorization": "Bearer " + adminToken },
                    success: function (category) {
                        $("#txtName").val(category.name || category.Name);
                        $("#txtDescription").val(category.description || category.Description);
                        $("#loader").addClass("d-none");
                        $("#updateCategoryForm").removeClass("d-none");
                    },
                    error: function (xhr) {
                        alert("Hata: Kategori bilgileri çekilemedi! Kategori bulunamamış olabilir.");
                        window.location.href = "/Category/Index";
                    }
                });
            }
        });

        window.updateCategory = function () {
            var updatedData = {
                id: parseInt(categoryId),
                name: $("#txtName").val().trim(),
                description: $("#txtDescription").val().trim()
            };

            if (!updatedData.name) {
                alert("Uyarı: Kategori adı boş bırakılamaz!");
                return;
            }

            const btn = $("button.btn-warning");
            const originalText = btn.html();
            btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Güncelleniyor...');

            $.ajax({
                url: API_URL + "/" + categoryId,
                type: "PUT",
                headers: { "Authorization": "Bearer " + adminToken },
                contentType: "application/json",
                data: JSON.stringify(updatedData),
                success: function (res) {
                    alert("Operasyon Başarılı: " + (res.message || "Kategori güncellendi."));
                    window.location.href = "/Category/Index";
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html(originalText);
                    alert("Hata: " + (xhr.responseJSON?.message || "Güncelleme başarısız oldu."));
                }
            });
        };
    </script>
}