@{
    ViewData["Title"] = "Yorumu Düzenle";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-warning text-dark p-4 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Yorumu Revize Et</h4>
            </div>
            <div class="card-body p-4">
                <form id="editCommentForm">
                    <input type="hidden" id="txtNewsId" />

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Yorum İçeriği <span class="text-danger">*</span></label>
                        <textarea id="txtText" class="form-control border-0 shadow-sm bg-light" rows="5" placeholder="Yorumunuzu güncelleyin..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-bold" onclick="goBack()">
                            <i class="bi bi-x-circle me-1"></i> İptal
                        </button>
                        <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow" onclick="updateComment()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7043/api/Comment";
        const token = localStorage.getItem("myToken");

        const pathArray = window.location.pathname.split('/');
        const commentId = pathArray[pathArray.length - 1];

        $(document).ready(function () {
            if (!token) {
                alert("Sistem Uyarısı: Bu işlemi yapabilmek için sisteme giriş yapmanız gerekmektedir.");
                window.location.href = "/Auth/Login";
                return;
            }

            if (!commentId || isNaN(commentId)) {
                alert("Geçersiz Yorum Kimliği!");
                window.location.href = "/Home/Index";
                return;
            }

            $.ajax({
                url: API_URL,
                type: "GET",
                headers: { "Authorization": "Bearer " + token },
                success: function (allComments) {
                    var currentComment = allComments.find(c => c.id == commentId);
                    if(currentComment) {
                        $("#txtText").val(currentComment.text || currentComment.Text);
                        $("#txtNewsId").val(currentComment.newsId || currentComment.NewsId);
                    } else {
                        alert("Yorum bulunamadı veya silinmiş olabilir!");
                        window.location.href = "/Home/Index";
                    }
                },
                error: function(xhr) {
                    if(xhr.status === 401) {
                        window.location.href = "/Auth/Login";
                    }
                }
            });
        });

        window.goBack = function() {
            var newsId = $("#txtNewsId").val();
            if (newsId && newsId !== "0") {
                window.location.href = "/Comment/Index/" + newsId;
            } else {
                window.history.back();
            }
        };

        window.updateComment = function () {
            var textVal = $("#txtText").val().trim();

            if(!textVal) {
                alert("Lütfen yorum içeriğini boş bırakmayın!");
                return;
            }

            var updateData = {
                newsId: parseInt($("#txtNewsId").val()),
                text: textVal
            };

            const btn = $("button.btn-primary");
            btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Güncelleniyor...');

            $.ajax({
                url: API_URL + "/" + commentId,
                type: "PUT",
                headers: { "Authorization": "Bearer " + token }, // 🛡️ Yetki zırhı
                contentType: "application/json",
                data: JSON.stringify(updateData),
                success: function (res) {
                    alert("Başarılı: " + (res.message || "Yorum güncellendi."));
                    goBack();
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html('<i class="bi bi-arrow-clockwise me-1"></i> Güncelle');
                    let errMsg = xhr.responseJSON?.message || "Güncelleme başarısız! Sadece kendi yorumunuzu değiştirebilirsiniz.";
                    alert("Hata: " + errMsg);
                }
            });
        };
    </script>
}