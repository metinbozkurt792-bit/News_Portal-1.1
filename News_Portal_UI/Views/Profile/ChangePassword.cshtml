@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-warning text-dark p-4 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-key-fill me-2"></i> Şifre Değiştirme</h4>
            </div>
            <div class="card-body p-4">
                <form id="passwordForm">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Mevcut Şifreniz</label>
                        <input type="password" id="txtCurrentPassword" class="form-control form-control-lg bg-light" placeholder="Şu anki şifrenizi girin">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Yeni Şifreniz</label>
                        <input type="password" id="txtNewPassword" class="form-control form-control-lg bg-light" placeholder="Yeni şifrenizi girin">
                    </div>
                    <div class="mb-5">
                        <label class="form-label fw-bold text-dark">Yeni Şifre (Tekrar)</label>
                        <input type="password" id="txtConfirmPassword" class="form-control form-control-lg bg-light" placeholder="Yeni şifrenizi tekrar girin">
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Profile/Index" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold px-4">Vazgeç</a>
                        <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold px-4 shadow-sm" onclick="changePassword()">Şifremi Değiştir</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7043/api/Profile/change-password";
        const token = localStorage.getItem("myToken");

        (function () {
            if (token) {
                try {
                    const payload = JSON.parse(atob(token.split('.')[1]));
                    const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || payload.role;
                    if (role === "Admin") {
                        window.location.href = "/Auth/AccessDeniedForAdmin";
                    }
                } catch (e) { console.error("Yetki kontrolü başarısız."); }
            }
        })();

        window.changePassword = function () {
            var currentPass = $("#txtCurrentPassword").val();
            var newPass = $("#txtNewPassword").val();
            var confirmPass = $("#txtConfirmPassword").val();

            if (!currentPass || !newPass || !confirmPass) {
                alert("Lütfen tüm alanları doldurun!"); return;
            }

            if (newPass !== confirmPass) {
                alert("Sistem Uyarısı: Yeni girdiğiniz şifreler birbiriyle eşleşmiyor!"); return;
            }

            var passwordData = {
                currentPassword: currentPass,
                newPassword: newPass
            };

            $.ajax({
                url: API_URL,
                type: "POST",
                headers: { "Authorization": "Bearer " + token },
                contentType: "application/json",
                data: JSON.stringify(passwordData),
                success: function (res) {
                    alert("Tebrikler: " + res.message);
                    $("#passwordForm")[0].reset();
                    window.location.href = "/Profile/Index";
                },
                error: function (xhr) {
                    alert("Hata: " + (xhr.responseJSON?.message || "Şifre değiştirme başarısız."));
                }
            });
        };
    </script>
}