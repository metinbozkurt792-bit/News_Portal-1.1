@{
    ViewData["Title"] = "Konuyu Güncelle";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-warning text-dark p-4 rounded-top-4 d-flex align-items-center">
                    <i class="bi bi-pencil-square fs-3 me-3"></i>
                    <h3 class="mb-0 fw-bold">Konuyu Revize Et</h3>
                </div>

                <div class="card-body p-5">
                    <form id="updateTopicForm">
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5 text-dark">Konu Başlığı <span class="text-danger">*</span></label>
                            <input type="text" id="txtTitle" class="form-control form-control-lg bg-light" placeholder="Başlık yükleniyor...">
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold fs-5 text-dark">Mesajınız <span class="text-danger">*</span></label>
                            <textarea id="txtContent" class="form-control bg-light" rows="8" placeholder="İçerik yükleniyor..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill fw-bold px-4" onclick="goBack()">
                                <i class="bi bi-arrow-left"></i> İptal ve Geri Dön
                            </button>
                            <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow-sm" onclick="saveUpdate()">
                                <i class="bi bi-check2-circle"></i> Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_FORUM_URL = "https://localhost:7043/api/Forum";
        const token = localStorage.getItem("myToken");
        const currentTopicId = "@ViewBag.TopicId";

        $(document).ready(function () {
            if (!token) {
                alert("Bu sayfaya erişim yetkiniz yok. Lütfen önce giriş yapın!");
                window.location.href = "/Auth/Login";
                return;
            }

            if (currentTopicId && !isNaN(currentTopicId) && currentTopicId !== "0") {
                loadTopicData();
            } else {
                alert("Geçersiz Konu ID!");
                window.location.href = "/Forum/Index";
            }
        });

        function loadTopicData() {
            $.ajax({
                url: API_FORUM_URL + "/topics/" + currentTopicId,
                type: "GET",
                headers: { "Authorization": "Bearer " + token },
                success: function (t) {
                    $("#txtTitle").val(t.title);
                    $("#txtContent").val(t.content);
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                        window.location.href = "/Auth/Login";
                    } else {
                        alert("Konu verileri çekilemedi veya bu konuyu düzenleme yetkiniz yok!");
                        window.location.href = "/Forum/Index";
                    }
                }
            });
        }

        window.goBack = function() {
            window.location.href = "/Forum/Index";
        };

        window.saveUpdate = function () {
            let newTitle = $("#txtTitle").val().trim();
            let newContent = $("#txtContent").val().trim();

            if (!newTitle || !newContent) {
                alert("Başlık ve içerik alanları boş bırakılamaz!");
                return;
            }

            let updateData = {
                title: newTitle,
                content: newContent
            };

            const btn = $("button.btn-primary");
            const originalText = btn.html();
            btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Kaydediliyor...');

            $.ajax({
                url: API_FORUM_URL + "/topics/" + currentTopicId,
                type: "PUT",
                headers: { "Authorization": "Bearer " + token },
                contentType: "application/json",
                data: JSON.stringify(updateData),
                success: function (res) {
                    alert("Tebrikler: " + res.message);
                    window.location.href = "/Forum/Index";
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html(originalText);
                    alert("Hata: " + (xhr.responseJSON?.message || "Sadece kendi açtığınız konuyu güncelleyebilirsiniz."));
                }
            });
        };
    </script>
}