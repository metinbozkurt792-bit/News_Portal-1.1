@{
    ViewData["Title"] = "Yeni Haber Ekle";
    Layout = "_AdminLayout";
}

<div class="card shadow-lg border-0 rounded-4 mt-4">
    <div class="card-header bg-primary text-white p-4 rounded-top-4">
        <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i> Yeni Haber Kaydı</h4>
    </div>
    <div class="card-body p-4">
        <form id="newsForm">
            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Haber Başlığı <span class="text-danger">*</span></label>
                <input type="text" id="txtTitle" class="form-control form-control-lg fs-6" placeholder="Çarpıcı bir manşet girin...">
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Kategori <span class="text-danger">*</span></label>
                <select id="ddlCategory" class="form-select form-select-lg fs-6">
                    <option value="0">Kategoriler Yükleniyor...</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Haber Görselleri (Çoklu Seçim)</label>
                <input type="file" id="fileImages" class="form-control" accept="image/*" multiple>
                <div class="form-text text-muted mt-2">
                    <i class="bi bi-info-circle me-1"></i> Birden fazla fotoğraf seçmek için CTRL tuşuna basılı tutun.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-secondary">Haber İçeriği <span class="text-danger">*</span></label>
                <textarea id="txtContent" class="form-control" rows="8" placeholder="Haber detaylarını buraya yazın..."></textarea>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="/News/Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Vazgeç
                </a>
                <button type="button" class="btn btn-success fw-bold rounded-pill px-5 shadow" onclick="saveNews()">
                    <i class="bi bi-cloud-upload me-2"></i> Kaydet ve Yayınla
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_NEWS_URL = "https://localhost:7043/api/News";
        const API_CATEGORY_URL = "https://localhost:7043/api/Category";
        const adminToken = localStorage.getItem("myToken");

        $(document).ready(function () {
            if (!adminToken) {
                window.location.href = "/Auth/Login";
                return;
            }
            loadCategories();
        });

        function loadCategories() {
            $.ajax({
                url: API_CATEGORY_URL,
                type: "GET",
                headers: { "Authorization": "Bearer " + adminToken }, 
                success: function (data) {
                    var options = '<option value="0">Lütfen Bir Kategori Seçin...</option>';
                    $.each(data, function (index, cat) {
                        options += `<option value="${cat.id}">${cat.name}</option>`;
                    });
                    $("#ddlCategory").html(options);
                },
                error: function (xhr) {
                    console.error("Kategoriler yüklenemedi", xhr);
                    $("#ddlCategory").html('<option value="0">Hata: Kategoriler Çekilemedi!</option>');
                }
            });
        }

        window.saveNews = function () {
            var title = $("#txtTitle").val().trim();
            var content = $("#txtContent").val().trim();
            var categoryId = parseInt($("#ddlCategory").val());

            if (!title) { alert("Hata: Haber başlığı boş bırakılamaz!"); return; }
            if (categoryId <= 0 || isNaN(categoryId)) { alert("Hata: Lütfen geçer de bir kategori seçin!"); return; }
            if (!content) { alert("Hata: Haber içeriği boş bırakılamaz!"); return; }

            var formData = new FormData();
            formData.append("Title", title);
            formData.append("Content", content);
            formData.append("CategoryId", categoryId);

            var files = $("#fileImages")[0].files;
            if (files.length > 0) {
                for (var i = 0; i < files.length; i++) {
                    formData.append("ImageFiles", files[i]);
                }
            }

            const btn = $("button.btn-success");
            const originalBtnHtml = btn.html();
            btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span> Gönderiliyor...');

            $.ajax({
                url: API_NEWS_URL,
                type: "POST",
                headers: { "Authorization": "Bearer " + adminToken },
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    alert("Operasyon Başarılı: Haber sisteme yüklendi!");
                    window.location.href = "/News/Index";
                },
                error: function (xhr) {
                    btn.prop("disabled", false).html(originalBtnHtml);
                    alert("Kayıt Başarısız! Hata: " + (xhr.responseJSON?.message || "Sunucuyla bağlantı kurulamadı."));
                }
            });
        };
    </script>
}