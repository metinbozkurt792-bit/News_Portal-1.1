@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_AuthLayout"; 
}

<div class="text-center mb-4">
    <div class="mb-3">
        <i class="bi bi-shield-lock-fill text-white" style="font-size: 3.5rem; filter: drop-shadow(0 0 10px rgba(255,255,255,0.3));"></i>
    </div>
    <h2 class="fw-bold text-white mb-2">Portal Girişi</h2>
    <p class="text-white-50 small">Sisteme erişmek için kimlik bilgilerinizi girin.</p>
</div>

<div id="authAlert" class="alert d-none border-0 shadow-sm mb-4" style="background: rgba(220, 53, 69, 0.2); color: #ff9999; border-radius: 12px;">
    <i class="bi bi-exclamation-octagon-fill me-2"></i>
    <span id="authAlertText" class="small fw-bold"></span>
</div>

<form id="loginForm">
    <div class="mb-3 text-start">
        <label class="form-label text-white-50 small fw-bold ms-2">E-POSTA ADRESİ</label>
        <input type="email" id="txtEmail" class="form-control form-control-lg bg-transparent text-white border-white-50"
               placeholder="kullanici@user.com" style="border-radius: 12px;">
    </div>

    <div class="mb-4 text-start">
        <label class="form-label text-white-50 small fw-bold ms-2">ŞİFRE</label>
        <input type="password" id="txtPassword" class="form-control form-control-lg bg-transparent text-white border-white-50"
               placeholder="******" style="border-radius: 12px;">
    </div>

    <button id="btnLogin" class="btn btn-primary w-100 fw-bold py-3 shadow-lg"
            style="border-radius: 12px; background: #ffffff; color: #0f172a; border: none;">
        Giriş Yap
    </button>

    <div class="mt-4 text-center">
        <p class="small text-white-50">
            Hesabın yok mu?
            <a href="/Auth/Register" class="text-white fw-bold text-decoration-none border-bottom border-white">Kayıt Ol</a>
        </p>
        <a href="/Home/Index" class="text-white-50 text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i> Siteye Dön
        </a>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#btnLogin").click(function (e) {
                e.preventDefault();

                const btn = $(this);
                const originalText = btn.html();

                var loginData = {
                    email: $("#txtEmail").val(),
                    password: $("#txtPassword").val()
                };

                var apiUrl = "https://localhost:7043/api/Auth/login";

                btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm"></span> Bekleyiniz...');
                $("#authAlert").addClass("d-none");

                $.ajax({
                    url: apiUrl,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(loginData),
                    success: function (response) {
                        localStorage.setItem("myToken", response.token);

                        try {
                            const payload = JSON.parse(atob(response.token.split('.')[1]));
                            const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || payload.role;

                            if (role === "Admin") {
                                window.location.href = "/Admin/Index";
                            } else {
                                window.location.href = "/Home/Index";
                            }
                        } catch (e) {
                            window.location.href = "/Home/Index";
                        }
                    },
                    error: function (xhr) {
                        btn.prop("disabled", false).html(originalText);
                        $("#authAlert").removeClass("d-none");
                        let errorMsg = xhr.responseJSON?.message || "E-Posta veya Şifre Hatalı!";
                        $("#authAlertText").text(errorMsg);
                    }
                });
            });
        });
    </script>
}