<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Haber Portalı</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-color: #2563eb;
            --accent-color: #f59e0b;
            --body-bg: #f8fafc;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--body-bg);
            color: #1e293b;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.9) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 15px 0;
        }

        .navbar-brand {
            font-size: 1.5rem;
            letter-spacing: -1px;
            color: var(--primary-color) !important;
        }

        .nav-link {
            font-weight: 500;
            color: #64748b !important;
            transition: color 0.3s ease;
            margin: 0 10px;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

        .user-avatar-nav {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-color);
        }

        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border-radius: 12px;
            padding: 10px;
        }

        .btn-auth {
            border-radius: 50px;
            padding: 8px 25px;
            font-weight: 600;
        }

        footer {
            background: #0f172a;
            color: #94a3b8;
            padding: 40px 0;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bolder" href="/Home/Index">
                <i class="bi bi-fire text-danger"></i> HABER<span class="text-dark">PORTALI</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto" id="mainNav">
                    <li class="nav-item">
                        <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                    </li>
                </ul>

                <div class="d-flex align-items-center" id="authArea">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4 min-vh-100">
        @RenderBody()
    </div>

    <footer class="mt-5">
        <div class="container text-center">
            <h5 class="text-white fw-bold mb-3">Haber Portalı</h5>
            <div class="fs-4">
                <i class="bi bi-facebook mx-2 text-primary"></i>
                <i class="bi bi-twitter-x mx-2 text-white"></i>
                <i class="bi bi-instagram mx-2 text-danger"></i>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const userToken = localStorage.getItem("myToken");

        $(document).ready(function () {
            renderNavbar();
        });

        function renderNavbar() {
            let navHtml = `
                <li class="nav-item">
                    <a class="nav-link" href="/Home/Index"><i class="bi bi-house-door me-1"></i> Anasayfa</a>
                </li>`;

            if (userToken) {
                navHtml += `
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary" href="/Forum/Index"><i class="bi bi-chat-left-dots me-1"></i> Forum</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Contact/Index"><i class="bi bi-envelope me-1"></i> İletişim</a>
                    </li>`;
            }
            $("#mainNav").html(navHtml);

            if (!userToken) {
                $("#authArea").html(`
                    <a href="/Auth/Login" class="btn btn-outline-primary btn-auth me-2">Giriş Yap</a>
                    <a href="/Auth/Register" class="btn btn-primary btn-auth shadow-sm">Kayıt Ol</a>
                `);
            } else {
                try {
                    const payload = JSON.parse(atob(userToken.split('.')[1]));
                    const name = payload["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"] || payload.unique_name || "Üye";
                    const role = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || payload.role;

                    let adminLink = role === "Admin" ? `<li><a class="dropdown-item text-danger fw-bold" href="/Admin/Index"><i class="bi bi-cpu-fill me-2"></i>Admin Paneli</a></li><li><hr class="dropdown-divider"></li>` : "";

                    $("#authArea").html(`
                        <div class="dropdown">
                            <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <img src="https://ui-avatars.com/api/?name=${name}&background=random" class="user-avatar-nav me-2" alt="Profil">
                                <span class="fw-bold text-dark d-none d-md-inline">${name}</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                ${adminLink}
                                <li><a class="dropdown-item" href="/Profile/Index"><i class="bi bi-person-circle me-2"></i>Profilim</a></li>
                                <li><a class="dropdown-item" href="/Home/Messages"><i class="bi bi-chat-dots me-2"></i>Mesajlarım</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="javascript:void(0)" onclick="userLogout()"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</a></li>
                            </ul>
                        </div>
                    `);
                } catch (e) {
                    console.error("Token çözme hatası:", e);
                    localStorage.removeItem("myToken");
                    location.reload();
                }
            }
        }

        window.userLogout = function () {
            if(confirm("Çıkış yapmak istediğinize emin misiniz?")) {
                localStorage.removeItem("myToken");
                window.location.href = "/Home/Index";
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>