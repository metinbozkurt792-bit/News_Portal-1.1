<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Haber Portalı</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-blue: #3b82f6;
            --accent-orange: #f59e0b;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #0f172a; 
            height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden; 
            position: relative;
        }

 
        .circle {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            opacity: 0.6;
        }

        .circle-blue {
            width: 300px;
            height: 300px;
            background: var(--primary-blue);
            top: 10%;
            left: 15%;
            animation: move-blue 15s infinite alternate;
        }

        .circle-orange {
            width: 250px;
            height: 250px;
            background: var(--accent-orange);
            bottom: 15%;
            right: 20%;
            animation: move-orange 12s infinite alternate;
        }

        .auth-container {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            color: white;
        }

        @@keyframes move-blue {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(50px, 100px);
            }
        }

        @@keyframes move-orange {
            from {
                transform: translate(0, 0);
            }

            to {
                transform: translate(-60px, -80px);
            }
        }

        .form-control {
            background: rgba(255, 255, 255, 0.1) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: white !important;
            border-radius: 12px;
            padding: 12px 15px;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.15) !important;
                box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
            }

        .btn-primary {
            background: #ffffff;
            color: #0f172a;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 700;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background: #f1f5f9;
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="circle circle-blue"></div>
    <div class="circle circle-orange"></div>

    <div class="auth-container">
        <div class="glass-card shadow-2xl">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>